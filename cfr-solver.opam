opam-version: "2.0"
synopsis:
  "Counterfactual regret minimization for imperfect-information games"
description:
  "Nash-equilibrium strategies for Kuhn poker and other imperfect-information games, computed with counterfactual regret minimization, with exact best responses and exploitability."
maintainer: ["Louis Belot"]
authors: ["Louis Belot"]
license: "MIT"
homepage: "https://github.com/Lemypoo/cfr-solver"
bug-reports: "https://github.com/Lemypoo/cfr-solver/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.0" & >= "3.0"}
  "cmdliner" {>= "1.3.0"}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Lemypoo/cfr-solver.git"
